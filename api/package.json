{
  "name": "cpm-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/index.js",
    "start": "node src/index.js",
    "start:dev": "npm run migrate && npm run seed && npm run dev",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/migrate.js --seed",
    "test": "node --test test/unit.test.js",
    "test:db": "node --test test/",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
