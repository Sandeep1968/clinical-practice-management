# Copy to .env and fill in. NEVER commit a real .env.
# The API refuses to start in production with development defaults.

NODE_ENV=production

# --- required in production ---
# generate: openssl rand -base64 48
JWT_SECRET=
DATABASE_URL=postgres://app_user:STRONG_PASSWORD@db.internal:5432/cpm
DATABASE_SSL=true

# comma-separated allowlist; no localhost in production
CORS_ORIGINS=https://app.yourdomain.com

# --- behaviour ---
PORT=4000
TRUST_PROXY=true          # set when behind a load balancer (correct client IP for rate limits)
REQUIRE_MFA=true          # refuse staff logins without TOTP enrolled
PG_POOL_MAX=20

# --- migrations (separate, higher-privilege credential) ---
MIGRATE_DATABASE_URL=postgres://postgres:STRONG_PASSWORD@db.internal:5432/cpm

# --- integrations (all optional; each stays in mock mode until set) ---
# every vendor below touches PHI and REQUIRES a signed BAA before real data
PVERIFY_CLIENT_ID=
PVERIFY_CLIENT_SECRET=
CLEARINGHOUSE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SES_REGION=
SMTP_URL=
ANTHROPIC_API_KEY=        # requires BAA + zero-retention agreement
